rules_version = '2';
// Quién puede usar Screenbook: los emails de la lista "config/allowlist" (campo "emails").
// Cada persona solo ve y cambia sus propias listas y ajustes.
service cloud.firestore {
  match /databases/{db}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(db)/documents/config/allowlist).data.emails;
    }
    // La lista de autorizados solo se cambia desde la consola de Firebase.
    match /config/allowlist {
      allow read, write: if false;
    }
    // Listas compartidas: solo las ven y cambian sus miembros.
    match /sharedLists/{id} {
      allow read, update, delete: if allowed() && request.auth.token.email in resource.data.members;
      allow create: if allowed() && request.resource.data.owner == request.auth.token.email
        && request.auth.token.email in request.resource.data.members;
    }
    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
      match /items/{item} {
        allow read, write: if allowed() && request.auth.uid == uid;
      }
    }
  }
}
